APP_NAME="OMR ICFES Backend"
APP_VERSION="0.1.0"
DEBUG=false
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://administrador:12345678@localhost:5432/omr_app"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
OMR_READER_BACKEND="classic"

# AI provider selection: openai | groq
AI_PROVIDER="openai"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.1"
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=4
OPENAI_RETRY_BACKOFF_SECONDS=1.0

# Groq
GROQ_API_KEY=""
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=4
GROQ_RETRY_BACKOFF_SECONDS=1.0
